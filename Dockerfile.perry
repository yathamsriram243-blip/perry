FROM node:24-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl git python3 \
  && rm -rf /var/lib/apt/lists/* \
  && useradd --create-home --home-dir /data --shell /bin/bash perry

WORKDIR /app
COPY --chown=perry:perry dist-server ./dist-server
COPY --chown=perry:perry dist ./dist
COPY --chown=perry:perry perry-docker-entrypoint.mjs ./perry-docker-entrypoint.mjs

ENV HOME=/data \
    OMB_DATA_DIR=/data/.openmausbot \
    OMB_STATIC_DIR=/app/dist \
    OMB_PORT=8799 \
    OMB_WEBHOOK_PORT=8800 \
    OMB_LOOPBACK_TRUST=owner \
    PERRY_EXTERNAL_PORT=8088 \
    NODE_ENV=production

VOLUME ["/data"]
USER perry
EXPOSE 8088 8799

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -sf http://127.0.0.1:8799/api/health || exit 1

CMD ["node", "perry-docker-entrypoint.mjs"]
